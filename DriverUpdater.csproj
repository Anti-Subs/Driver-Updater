<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows build: "dotnet build -c Release" (needs the .NET SDK). Output: bin\Release\net48\DriverUpdater.exe
       Rename the exe to DriverUpdaterSetup-<version>.exe to get the installer behaviour. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>DriverUpdater</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>assets\app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>
